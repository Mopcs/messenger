# =========================================================
# Messenger — шаблон локальной конфигурации
# Скопируйте в .env и замените все change-me значения.
# =========================================================

# ---------- Приложение ----------
APP_NAME=Messenger
APP_ENV=development
APP_DEBUG=true
APP_BASE_URL=http://127.0.0.1:8080
HTTP_ADDR=127.0.0.1:8080
SHUTDOWN_TIMEOUT=10s

LOG_LEVEL=debug
LOG_FORMAT=text

# ---------- pgAdmin (docker-compose.admin.yml) ----------
PGADMIN_DEFAULT_EMAIL=admin@messenger.local
PGADMIN_DEFAULT_PASSWORD=change-me-pgadmin
PGADMIN_PORT=5050

# ---------- PostgreSQL ----------
POSTGRES_DB=messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=change-me-postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432

DATABASE_URL=postgres://messenger:change-me-postgres@127.0.0.1:55432/messenger?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis
REDIS_DB=0
REDIS_URL=redis://:change-me-redis@127.0.0.1:6379/0

# ---------- Аутентификация ----------
JWT_ISSUER=messenger
JWT_AUDIENCE=messenger-web
JWT_SECRET=change-me-jwt-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
EMAIL_VERIFICATION_TTL=24h
PASSWORD_RESET_TTL=1h

PASSWORD_HASH_ALGO=argon2id
ARGON2_MEMORY_KIB=65536
ARGON2_ITERATIONS=3
ARGON2_PARALLELISM=2
ARGON2_SALT_LENGTH=16
ARGON2_KEY_LENGTH=32

SESSION_COOKIE_NAME=messenger_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax

# ---------- Безопасность ----------
SESSION_SECRET=change-me-session-secret
ENCRYPTION_KEY=change-me-encryption-key
UPLOAD_SIGNING_SECRET=change-me-upload-signing-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080
TRUSTED_PROXIES=127.0.0.1/32

# ---------- Файлы ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./var/uploads
STORAGE_PUBLIC_BASE_URL=http://127.0.0.1:8080/media
MAX_UPLOAD_SIZE=26214400
MAX_ATTACHMENTS_PER_MESSAGE=10
STORAGE_DELETION_WORKERS=2
STORAGE_DELETION_INTERVAL=30s
STORAGE_URL_TTL=15m

# ---------- Ограничения сообщений ----------
MESSAGE_MAX_LENGTH=4096
GROUP_TITLE_MAX_LENGTH=128
GROUP_DESCRIPTION_MAX_LENGTH=4000
DISPLAY_NAME_MAX_LENGTH=64

# ---------- SMTP (локально: MailHog/Papercut) ----------
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@messenger.local
SMTP_TLS=false

# ---------- Миграции ----------
MIGRATIONS_DIR=./db/migrations_hardened
AUTO_MIGRATE=false
